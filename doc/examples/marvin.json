{
  "settings": {
    "name": "marvin",
    "host": "127.0.0.1",
    "port": 7331,
    "logLevel": "info",
    "apiToken": "changeme"
  },
  "channels": {
    "slack": {
      "enabled": true,
      "appToken": "xapp-1-app-token",
      "botToken": "xoxb-bot-token"
    }
  },
  "agents": {
    "my-agent": {
      "enabled": true,
      "channels": {
        "slack": "C123"
      }
    }
  },
  "tasks": {
    "my-task": {
      "enabled": true,
      "agent": "my-agent",
      "schedule": 3600,
      "maxSteps": 20,
      "format": "json"
    }
  },
  "integrations": {
    "gloobeam": {
      "enabled": true,
      "type": "wordpress",
      "endpoint": "https://gloobeam.com",
      "user": "admin",
      "appPassword": "xxxx xxxx xxxx xxxx xxxx xxxx"
    }
  },
  "mcps": {
    "gloobeam": {
      "enabled": true,
      "command": "npx",
      "args": [
        "-y",
        "@automattic/mcp-wordpress-remote@latest"
      ],
      "env": {
        "WP_API_URL": "https://gloobeam.com/wp-json/mcp/mcp-adapter-default-server",
        "WP_API_USERNAME": "admin",
        "WP_API_PASSWORD": "xxxx xxxx xxxx xxxx xxxx xxxx"
      }
    }
  },
  "models": {
    "deepseek/deepseek-v4-flash": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash",
      "apiKey": "sk-api-ket",
      "enabled": true
    }
  }
}
