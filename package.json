{
  "name": "marvin",
  "version": "0.9.8",
  "description": "mArvIn - your AI sidekick",
  "keywords": [
    "marvin",
    "ai",
    "ai sidekick"
  ],
  "author": "Radu Ionita",
  "license": "ISC",
  "private": true,
  "main": "marvin.ts",
  "bin": {
    "marvin": "src/marvin.ts"
  },
  "type": "module",
  "scripts": {
    "build": "npx tsc --noEmit",
    "watch": "npx tsc --watch",
    "nuke": "rm -rf out node_modules",
    "start": "bun run src/marvin.ts serve",
    "compile:linux": "bun build --compile --minify ./src/marvin.ts --outfile ./marvin",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.9.1",
    "@types/turndown": "^5.0.6",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@inquirer/editor": "^5.3.1",
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0",
    "dotenv": "^17.4.2",
    "puppeteer": "^25.3.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "turndown": "^7.2.4"
  }
}
