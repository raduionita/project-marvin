[Unit]
Description=mArvIn - your AI Sidekick
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.marvin
EnvironmentFile=%h/.marvin/.env
ExecStart=%h/.local/bin/marvin serve
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.marvin/logs/marvin.log
StandardError=append:%h/.marvin/logs/marvin.log
# rotate the log daily, keep the last 7 files
LogRotate=date
LogRotateN=7
SyslogIdentifier=marvin

[Install]
WantedBy=default.target
