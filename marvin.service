[Unit]
Description=mArvIn - your AI Sidekick
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.marvin
EnvironmentFile=%h/.marvin/.env
ExecStart=/usr/local/bin/marvin serve
Restart=on-failure
RestartSec=10
StandardOutput=append:%h/.marvin/marvin.log
StandardError=append:%h/.marvin/marvin.log
SyslogIdentifier=marvin

[Install]
WantedBy=default.target
